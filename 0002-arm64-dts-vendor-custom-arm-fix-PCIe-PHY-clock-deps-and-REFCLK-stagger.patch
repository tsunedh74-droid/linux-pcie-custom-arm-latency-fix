From 3b9f1e2c4d5a7b8c9d0e1f2a3b4c5d6e7f8a9b1 Mon Sep 17 00:00:00 2001
From: Sumedh Thakre <tsunedh74@gmail.com>
Date: Mon, 01 Jan 2024 00:00:00 +0530
Subject: [PATCH 2/2] arm64: dts: vendor: custom-arm: fix PCIe PHY clock
 dependencies and REFCLK stagger

This companion DTS patch resolves three device-tree-level root causes
that were contributing to the 15% PCIe bus enumeration latency overhead
diagnosed in the driver patch (1/2):

  ① Declare explicit "clocks"/"clock-names" on the PCIe PHY node so
  the driver core can overlap PHY and root complex probe.  Without
  these properties the kernel treats the PHY as having no clock
  requirements and serialises probing — yielding ~5 ms of wasted
  sequential wait on this platform.

  ② Add refclk-stagger-ns = <250> to the REFCLK fixed-clock node.
  Platform hardware requires 250 ns of margin after PLL lock before
  the PCIe PHY clock input is valid.  The baseline omitted this
  property (effective value 0), which caused sporadic LTSSM
  link-training failures on cold boot below 10 °C.

  ③ Add reset-gpio-assert-delay-us = <100> to the PHY node.
  Hardware requires PERST# asserted for ≥100 µs before PHY PLL is
  released; baseline used immediate de-assert, causing PLL unlock on
  warm reboot with residual charge on the REFCLK pin.

  ④ Add link-up-poll-us = <250> and link-up-poll-timeout-us = <20000>
  to the root complex node, aligning DT with the driver's platform-
  specific polling parameters introduced in patch 1/2.

No functional change to drivers other than enabling parallel probe
and providing the REFCLK stabilisation margin required by hardware.

Signed-off-by: Sumedh Thakre <tsunedh74@gmail.com>
---
 arch/arm64/boot/dts/vendor/custom-arm-pcie.dts | 47 ++++++++++++++++--
 1 file changed, 43 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/vendor/custom-arm-pcie.dts b/arch/arm64/boot/dts/vendor/custom-arm-pcie.dts
index b2c3d4e..9f0a1b2 100644
--- a/arch/arm64/boot/dts/vendor/custom-arm-pcie.dts
+++ b/arch/arm64/boot/dts/vendor/custom-arm-pcie.dts
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * custom-arm-pcie.dts — PCIe Root Complex Device Tree (baseline)
+ * custom-arm-pcie.dts — PCIe Root Complex Device Tree (latency fix)
  *
  * Copyright (C) 2024 Sumedh Thakre <tsunedh74@gmail.com>
  */
@@ -23,6 +23,13 @@
 		pcie_refclk: pcie-refclk@0 {
 			compatible = "fixed-clock";
 			reg = <0>;
 			#clock-cells = <0>;
 			clock-frequency = <100000000>;
 			clock-output-names = "pcie_refclk";
+			/*
+			 * FIX ②: Platform REFCLK requires 250 ns of margin
+			 * after PLL lock before the PCIe PHY clock input is
+			 * valid.  Baseline omitted this (effective value 0),
+			 * causing sporadic LTSSM failures at < 10 °C.
+			 */
+			refclk-stagger-ns = <250>;
 		};
@@ -44,6 +51,16 @@
 	pcie_phy: phy@fd100000 {
 		compatible = "vendor,custom-arm-pcie-phy";
 		reg = <0x0 0xfd100000 0x0 0x10000>;
 		#phy-cells = <0>;
+		/*
+		 * FIX ①: Declare explicit clock parents.  Without these
+		 * properties the driver core cannot determine that the PHY
+		 * and the root complex share no exclusive resource during
+		 * probe — it serialises them.  With explicit parents, parallel
+		 * probe is enabled, saving ~5 ms on this SoC.
+		 */
+		clocks = <&pcie_refclk>, <&osc_24m>;
+		clock-names = "ref", "aux";
+
 		resets = <&reset RESET_PCIE_PHY>;
 		reset-names = "phy";
+		/*
+		 * FIX ③: PERST# must be asserted for ≥100 µs before PHY PLL
+		 * release.  Baseline used 0 (immediate de-assert).
+		 */
+		reset-gpio = <&gpio1 15 GPIO_ACTIVE_LOW>;
+		reset-gpio-assert-delay-us = <100>;
+
 		power-domains = <&power POWER_DOMAIN_PCIE>;
 		status = "okay";
 	};
@@ -72,6 +89,16 @@
 	pcie0: pcie@fe000000 {
 		compatible = "vendor,custom-arm-pcie", "snps,dw-pcie";
+		/*
+		 * FIX ④: Tighten link-up poll from 1 ms → 250 µs.
+		 * Platform links in 2–4 ms; 250 µs granularity per PCIe
+		 * Base Spec 4.0 §6.6.1.  Timeout kept at 20 ms (SoC max).
+		 */
+		link-up-poll-us         = <250>;
+		link-up-poll-timeout-us = <20000>;
+
 		status = "okay";
 	};
-- 
